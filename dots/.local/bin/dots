#!/usr/bin/env bash

set -euo pipefail

program=${0##*/}
dry_run=false
deploy_system=false
deploy_all=false
assume_yes=false
declare -a requested_manual_packages=()

usage() {
  cat <<EOF
Usage: $program deploy [--dry-run] [--system --yes] [--all]
                       [--no-folding-pkg PACKAGE]
       $program update [--dry-run]

Deploy changed GNU Stow packages from ~/dotfiles.

  --dry-run  Print the deployment plan without changing anything
  --system   Also install the repository's greetd and PAM templates (requires --yes)
  --yes      Confirm overwriting system files when used with --system
  --all      Restow every package, including packages requiring manual Stow options
  --no-folding-pkg PACKAGE
             Explicitly deploy neovim or obsidian safely

Both commands also install any missing package listed in
setup/manifests/scripts.txt (the scripts' own libraries and helpers) with
pacman -S --needed, through doas or sudo, after asking.

update pulls the configured upstream with --ff-only, then deploys packages
changed by the new commit. A branch with no upstream pulls the same-named
branch from \$DOTS_REMOTE (default origin), or skips the pull when the remote
has no such branch. --dry-run reports the current deployment plan and does not
contact the remote or modify files.
EOF
}

fail() {
  printf '%s: error: %s\n' "$program" "$*" >&2
  exit 1
}

if (($# == 0)); then
  usage >&2
  exit 2
fi

command_name=$1
shift
case $command_name in
  deploy|update) ;;
  *)
  printf '%s: unknown command: %s\n' "$program" "$command_name" >&2
  usage >&2
  exit 2
  ;;
esac

while (($# > 0)); do
  case $1 in
    --dry-run) dry_run=true ;;
    --system) deploy_system=true ;;
    --all) deploy_all=true ;;
    --yes) assume_yes=true ;;
    --no-folding-pkg)
      (($# >= 2)) || fail "--no-folding-pkg requires a package name"
      requested_manual_packages+=("$2")
      shift
      ;;
    -h|--help) usage; exit 0 ;;
    *)
      printf '%s: unknown option: %s\n' "$program" "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [[ $deploy_system == true && $assume_yes != true ]]; then
  fail "--system requires explicit confirmation with --yes"
fi

if [[ $command_name == update ]]; then
  [[ $deploy_system == false && $deploy_all == false && ${#requested_manual_packages[@]} == 0 ]] ||
    fail "update only accepts --dry-run"
fi

command -v git >/dev/null 2>&1 || fail "git is required"

repo=${DOTS_REPO:-"$HOME/dotfiles"}
state_file=${DOTS_STATE_FILE:-"${XDG_STATE_HOME:-$HOME/.local/state}/dots/last-deployed"}
[[ -d $repo ]] || fail "repository not found: $repo"
git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
  fail "not a Git repository: $repo"

if [[ $command_name == update ]]; then
  if [[ $dry_run == true ]]; then
    exec "$0" deploy --dry-run
  fi
  printf 'Pulling updates for %s...\n' "$repo"
  # A branch created locally and pushed without -u has no upstream, so a bare
  # `git pull` refuses to run. Fall back to the same-named branch on the remote,
  # and deploy the checkout as-is when there is nothing to pull from. Tracking
  # config is read directly so an upstream pruned from the remote still fails
  # the pull instead of passing for a local-only branch.
  if ! branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD); then
    printf 'Notice: HEAD is detached; skipping pull and deploying the current checkout.\n'
  elif git -C "$repo" config --get "branch.$branch.merge" >/dev/null; then
    git -C "$repo" pull --ff-only ||
      fail "git pull --ff-only failed; resolve local changes or upstream history, then retry"
  else
    remote=${DOTS_REMOTE:-origin}
    remote_status=0
    git -C "$repo" ls-remote --exit-code --heads "$remote" "refs/heads/$branch" \
      >/dev/null || remote_status=$?
    case $remote_status in
      0)
        printf 'Notice: %s has no upstream; pulling %s/%s.\n' "$branch" "$remote" "$branch"
        git -C "$repo" pull --ff-only "$remote" "$branch" ||
          fail "git pull --ff-only $remote $branch failed; resolve local changes or upstream history, then retry"
        ;;
      2)
        printf 'Notice: %s has no upstream and is not on %s; skipping pull and deploying the current checkout.\n' \
          "$branch" "$remote"
        ;;
      *) fail "cannot reach remote '$remote' to look for $branch" ;;
    esac
  fi
  exec "$repo/dots/.local/bin/dots" deploy
fi

# The scripts' small runtime dependencies (Python libraries, capture helpers),
# checked on every run so a dependency added upstream arrives with the scripts
# that need it. `pacman -T` prints only what is missing and needs no root.
deps_manifest=$repo/setup/manifests/scripts.txt
pacman_cmd=${DOTS_PACMAN:-pacman}
declare -a missing_deps=()
deps_unchecked=false
if [[ -f $deps_manifest ]]; then
  if command -v "$pacman_cmd" >/dev/null 2>&1; then
    declare -a wanted_deps=()
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line == \#* ]] && continue
      line=${line//[[:space:]]/}
      [[ -n $line ]] && wanted_deps+=("$line")
    done < "$deps_manifest"
    if ((${#wanted_deps[@]} > 0)); then
      while IFS= read -r dep; do
        [[ -n $dep ]] && missing_deps+=("$dep")
      done < <("$pacman_cmd" -T "${wanted_deps[@]}" || true)
    fi
  else
    deps_unchecked=true
  fi
fi

head_sha=$(git -C "$repo" rev-parse --verify 'HEAD^{commit}') ||
  fail "cannot resolve HEAD in $repo"

# Stow links the work tree, not HEAD, so local edits deploy too. When a pull's
# autostash pops back with conflicts, git exits 0 and leaves <<<<<<< markers
# behind; deploying them breaks whatever parses the file (a Bar.qml with
# markers takes the whole bar down). Refuse until the conflict is resolved.
# Unmerged index entries catch the usual case; `diff --check` also catches
# markers that were staged with `git add` before being fixed.
conflicted=$(
  {
    git -C "$repo" diff --name-only --diff-filter=U
    # --check exits non-zero when it finds anything; only its output matters.
    { git -C "$repo" diff --check HEAD 2>/dev/null || true; } |
      sed -n 's/^\(.*\):[0-9][0-9]*: leftover conflict marker$/\1/p'
  } | sort -u
)
if [[ -n $conflicted ]]; then
  printf '%s: error: %s has unresolved merge conflicts; resolve them, then retry:\n' \
    "$program" "$repo" >&2
  printf '%s\n' "$conflicted" | sed 's/^/  /' >&2
  exit 1
fi

# wallpaper: ~/Pictures/Wallpapers is owned by wallpaper-sync, which links it to
# its own worktree at origin/main rather than to this checkout's branch.
is_excluded() {
  case $1 in
    .github|docs|wiki|tests|system|setup|dotfiles|neovim|obsidian|wallpaper) return 0 ;;
    *) return 1 ;;
  esac
}

is_manual_package() {
  case $1 in
    neovim|obsidian) return 0 ;;
    *) return 1 ;;
  esac
}

# systemd: a folded ~/.config/systemd would be a symlink into this checkout, so
# `systemctl --user enable` and `edit` would write *.wants links and drop-ins
# into the repository.
uses_no_folding() {
  case $1 in
    neovim|btop|obsidian|systemd) return 0 ;;
    *) return 1 ;;
  esac
}

declare -a all_packages=()
declare -a manual_packages=()
declare -A is_package=()
git -C "$repo" ls-tree -d --name-only HEAD >/dev/null ||
  fail "cannot list packages in $repo"
while IFS= read -r -d '' directory; do
  if is_manual_package "$directory"; then
    manual_packages+=("$directory")
    is_package["$directory"]=1
  elif ! is_excluded "$directory"; then
    all_packages+=("$directory")
    is_package["$directory"]=1
  fi
done < <(git -C "$repo" ls-tree -z -d --name-only HEAD)

declare -A requested_manual=()
for package in "${requested_manual_packages[@]}"; do
  is_manual_package "$package" ||
    fail "--no-folding-pkg only accepts neovim or obsidian (got '$package')"
  [[ -n ${is_package["$package"]+present} ]] ||
    fail "package not found in repository: $package"
  requested_manual["$package"]=1
done

first_deploy=false
last_sha=
if [[ -f $state_file ]]; then
  IFS= read -r last_sha < "$state_file" || true
  [[ -n $last_sha ]] || fail "deployment state is empty: $state_file"
  git -C "$repo" rev-parse --verify --quiet "${last_sha}^{commit}" >/dev/null ||
    fail "deployment state does not name a commit: $last_sha"
else
  first_deploy=true
fi

declare -a packages=()
if [[ $deploy_all == true ]]; then
  packages=("${all_packages[@]}")
  packages+=("${manual_packages[@]}")
elif [[ $first_deploy == true ]]; then
  packages=("${all_packages[@]}")
else
  declare -A changed_packages=()
  git -C "$repo" diff --name-only "$last_sha" HEAD -- >/dev/null ||
    fail "cannot compare $last_sha with HEAD"
  while IFS= read -r -d '' path; do
    top=${path%%/*}
    if [[ $path == */* && -n ${is_package["$top"]+present} ]]; then
      changed_packages["$top"]=1
    fi
  done < <(git -C "$repo" diff --name-only -z "$last_sha" HEAD --)

  for package in "${all_packages[@]}"; do
    if [[ -n ${changed_packages["$package"]+present} ]]; then
      packages+=("$package")
    fi
  done
fi

if [[ $deploy_all != true ]]; then
  for package in "${manual_packages[@]}"; do
    if [[ -n ${requested_manual["$package"]+present} ]]; then
      packages+=("$package")
    fi
  done
fi

printf 'Repository: %s\n' "$repo"
printf 'Target commit: %s\n' "$head_sha"
if [[ $first_deploy == true ]]; then
  printf 'Notice: no previous deployment record; deploying all packages.\n'
elif [[ $deploy_all == true ]]; then
  printf 'Notice: --all selected; deploying all packages.\n'
else
  printf 'Previous commit: %s\n' "$last_sha"
fi
if [[ $deploy_all != true ]]; then
  for package in "${manual_packages[@]}"; do
    if [[ -z ${requested_manual["$package"]+present} ]]; then
      printf 'Notice: %s skipped: requires manual stow - see README.\n' "$package"
    fi
  done
fi

printf 'Packages:\n'
if ((${#packages[@]} == 0)); then
  printf '  (none)\n'
else
  for package in "${packages[@]}"; do
    printf '  - %s\n' "$package"
  done
fi

# A package selected from the commit diff can have been deleted by that very
# diff (or by an uncommitted removal): HEAD still lists the directory, but it is
# no longer on disk, and `stow --restow` on it aborts the whole run with
#   ERROR: The stow directory does not contain package <name>
# A removed package's links are dangling, so the correct action is to unstow it.
package_removed() { [[ ! -d "$repo/$1" ]]; }

printf 'Actions:\n'
for package in "${packages[@]}"; do
  if package_removed "$package"; then
    printf '  - stow --delete --target %q %q (package removed from repository)\n' \
      "$HOME" "$package"
  elif uses_no_folding "$package"; then
    printf '  - stow --restow --no-folding --target %q %q\n' \
      "$HOME" "$package"
  else
    printf '  - stow --restow --target %q %q\n' "$HOME" "$package"
  fi
done
if [[ -n ${is_package[hypr]+present} ]]; then
  for package in "${packages[@]}"; do
    if [[ $package == hypr ]]; then
      printf '  - reload Hyprland if a session is live\n'
      break
    fi
  done
fi
if [[ -n ${is_package[quickshell]+present} ]]; then
  for package in "${packages[@]}"; do
    if [[ $package == quickshell ]]; then
      printf '  - reload Hyprland and restart Quickshell if a session is live\n'
      break
    fi
  done
fi
if [[ $deploy_system == true ]]; then
  system_root=${DOTS_SYSTEM_ROOT:-}
  greetd_target="$system_root/etc/greetd/config.toml"
  pam_target_dir="$system_root/etc/pam.d"
  printf 'Warning: system/pam.d templates hardcode host identity pam://Kelper.\n'
  printf '  - sudo mkdir -p %s\n' "${greetd_target%/*}"
  if [[ -e $greetd_target ]]; then
    printf '  - back up existing %s before overwrite\n' "$greetd_target"
  fi
  printf '  - sudo install -m 0644 system/greetd/config.toml %s\n' "$greetd_target"
  for pam_file in "$repo"/system/pam.d/*; do
    [[ -f $pam_file ]] || fail "no PAM templates found in $repo/system/pam.d"
    pam_target="$pam_target_dir/${pam_file##*/}"
    if [[ -e $pam_target ]]; then
      printf '  - back up existing %s before overwrite\n' "$pam_target"
    fi
    printf '  - sudo install -m 0644 %s %s\n' \
      "${pam_file#"$repo"/}" "$pam_target"
  done
fi
if ((${#missing_deps[@]} > 0)); then
  printf '  - install script dependencies: %s\n' "${missing_deps[*]}"
fi
if [[ $deps_unchecked == true ]]; then
  printf 'Notice: %s not found; script dependencies were not checked.\n' "$pacman_cmd"
fi
if ((${#packages[@]} == 0 && ${#missing_deps[@]} == 0)) && [[ $deploy_system == false ]]; then
  printf '  (state record only; no package changes)\n'
fi

if [[ $dry_run == true ]]; then
  printf 'Dry run: no changes made.\n'
  exit 0
fi

if ((${#packages[@]} > 0)); then
  command -v stow >/dev/null 2>&1 || fail "stow is required to deploy packages"
fi
if [[ $deploy_system == true ]]; then
  command -v sudo >/dev/null 2>&1 || fail "sudo is required with --system"
  [[ -f $repo/system/greetd/config.toml ]] ||
    fail "missing system template: $repo/system/greetd/config.toml"
fi

# A QML edit only reaches the running desktop if the shell process is
# replaced, so deploying quickshell restarts it. The reload script drives
# Hyprland too, which makes the plain hypr reload below redundant when both
# packages were deployed together.
reload_hypr=false
restart_shell=false
shell_reload_script="$repo/hypr/.config/hypr/scripts/shell-reload.sh"
for package in "${packages[@]}"; do
  case $package in
    hypr|quickshell) ;;
    *) continue ;;
  esac
  command -v pgrep >/dev/null 2>&1 ||
    fail "pgrep is required to check for a live Hyprland session"
  pgrep -x Hyprland >/dev/null 2>&1 || continue
  command -v hyprctl >/dev/null 2>&1 ||
    fail "Hyprland is live but hyprctl is unavailable"
  if [[ $package == quickshell ]]; then
    [[ -x $shell_reload_script ]] ||
      fail "missing or non-executable reload script: $shell_reload_script"
    restart_shell=true
  else
    reload_hypr=true
  fi
done

# Installed before restowing, so a script is usable the moment it is linked.
# A refused or failed install does not stop the deploy: configs still go out,
# and the run ends with an error naming what is missing.
deps_failed=false
if ((${#missing_deps[@]} > 0)); then
  interactive=${DOTS_INTERACTIVE:-}
  if [[ -z $interactive ]]; then
    if [[ -t 0 ]]; then interactive=1; else interactive=0; fi
  fi
  elevate=${DOTS_SUDO:-}
  if [[ -z $elevate ]]; then
    if command -v doas >/dev/null 2>&1; then elevate=doas; else elevate=sudo; fi
  fi
  if [[ $interactive != 1 ]]; then
    printf 'Notice: no terminal to ask for a password; skipping script dependencies.\n'
    deps_failed=true
  elif ! command -v "$elevate" >/dev/null 2>&1; then
    printf 'Notice: %s not found; skipping script dependencies.\n' "$elevate"
    deps_failed=true
  else
    printf 'Installing script dependencies: %s\n' "${missing_deps[*]}"
    "$elevate" "$pacman_cmd" -S --needed "${missing_deps[@]}" || deps_failed=true
  fi
fi

for package in "${packages[@]}"; do
  if package_removed "$package"; then
    printf 'Unstowing %s (removed from repository)...\n' "$package"
    # Best effort: with the package gone, stow cannot know which links were
    # its, so nothing may be removed. That is not a reason to fail the run.
    (cd "$repo" && stow --delete --target "$HOME" "$package") 2>/dev/null ||
      printf 'Notice: %s had no links left to remove.\n' "$package"
    continue
  fi

  printf 'Restowing %s...\n' "$package"
  declare -a stow_args=(--restow)
  if uses_no_folding "$package"; then
    stow_args+=(--no-folding)
  fi
  stow_args+=(--target "$HOME")
  stow_args+=("$package")
  if ! (cd "$repo" && stow "${stow_args[@]}"); then
    fail "stow failed for '$package'; resolve the reported conflict and retry (files were not adopted or overwritten)"
  fi
done

if [[ $deploy_system == true ]]; then
  timestamp=$(date -u +%Y%m%dT%H%M%S%NZ)
  declare -a system_sources=("$repo/system/greetd/config.toml")
  declare -a system_targets=("$greetd_target")
  for pam_file in "$repo"/system/pam.d/*; do
    [[ -f $pam_file ]] || fail "no PAM templates found in $repo/system/pam.d"
    system_sources+=("$pam_file")
    system_targets+=("$pam_target_dir/${pam_file##*/}")
  done

  declare -a system_backups=()
  for target in "${system_targets[@]}"; do
    backup=
    if [[ -e $target ]]; then
      backup="${target}.pre-dots.${timestamp}"
      suffix=2
      while [[ -e $backup ]]; do
        backup="${target}.pre-dots.${timestamp}.${suffix}"
        suffix=$((suffix + 1))
      done
      sudo cp -a -- "$target" "$backup" || fail "could not back up $target"
      printf 'Backup: %s -> %s\n' "$target" "$backup"
    fi
    system_backups+=("$backup")
  done

  printf 'Rollback instructions:\n'
  for index in "${!system_targets[@]}"; do
    target=${system_targets[$index]}
    backup=${system_backups[$index]}
    if [[ -n $backup ]]; then
      printf '  sudo cp -a -- %q %q\n' "$backup" "$target"
    else
      printf '  sudo rm -f -- %q  # target did not previously exist\n' "$target"
    fi
  done

  sudo mkdir -p -- "${greetd_target%/*}" || fail "could not create ${greetd_target%/*}"
  for index in "${!system_sources[@]}"; do
    sudo install -m 0644 "${system_sources[$index]}" "${system_targets[$index]}" ||
      fail "could not install ${system_targets[$index]}"
  done
fi

if [[ $restart_shell == true ]]; then
  printf 'Reloading Hyprland and restarting Quickshell...\n'
  "$shell_reload_script" || fail "shell-reload.sh failed"
elif [[ $reload_hypr == true ]]; then
  printf 'Reloading Hyprland...\n'
  hyprctl reload || fail "hyprctl reload failed"
fi

state_dir=${state_file%/*}
if [[ $state_dir == "$state_file" ]]; then
  state_dir=.
fi
if [[ ! -d $state_dir ]]; then
  old_umask=$(umask)
  umask 077
  mkdir -p "$state_dir"
  umask "$old_umask"
  chmod 0700 "$state_dir"
fi
state_tmp=$(mktemp "$state_dir/.last-deployed.XXXXXX") ||
  fail "cannot create deployment state in $state_dir"
trap 'rm -f "$state_tmp"' EXIT
printf '%s\n' "$head_sha" > "$state_tmp"
chmod 0600 "$state_tmp"
mv -f "$state_tmp" "$state_file"
trap - EXIT

printf 'Deployed %s and updated %s.\n' "$head_sha" "$state_file"

if [[ $deps_failed == true ]]; then
  printf '%s: error: script dependencies not installed: %s\n' "$program" "${missing_deps[*]}" >&2
  printf 'Install them with: sudo pacman -S --needed %s\n' "${missing_deps[*]}" >&2
  printf '(If pacman cannot find a package, sync first with: sudo pacman -Syu)\n' >&2
  exit 1
fi
