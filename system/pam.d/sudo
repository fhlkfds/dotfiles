#%PAM-1.0

# Touch-only YubiKey. The attached key has no fingerprint sensor and no built-in
# user verification, so presence is the only factor it can offer: a tap proves
# the key is plugged in, not who pressed it. Registration must therefore use
# `yubikey-auth setup --mode touch` (the default for such a key); a credential
# registered with --mode bio or --mode pin will not satisfy this line.
# Host sensor first: one scan, up to 10 seconds, then the YubiKey tap;
# system-auth remains the password fallback whenever both are absent.
# The leading '-' suppresses missing-module logs on hosts without fprintd.
-auth      sufficient                  pam_fprintd.so      max-tries=1 timeout=10
auth       sufficient                  pam_u2f.so          authfile=/etc/u2f_mappings cue origin=pam://Kelper appid=pam://Kelper userpresence=1 pinverification=0 userverification=0
auth       include                     system-auth
account    include                     system-auth
session    include                     system-auth
session    optional                    pam_systemd.so      class=none
