#%PAM-1.0

# doas is the escalation command this desktop actually uses: .zshrc aliases
# `sudo` to it, so a YubiKey stack deployed only to /etc/pam.d/sudo would never
# be reached. Enter the password normally, or submit an empty prompt and touch
# the key. A correct password skips the key and is checked by system-auth.
auth       [success=1 default=ignore]  pam_unix.so
auth       sufficient                  pam_u2f.so          authfile=/etc/u2f_mappings cue origin=pam://Kelper appid=pam://Kelper userpresence=1 pinverification=0 userverification=0
auth       include                     system-auth
account    include                     system-auth
session    include                     system-auth
