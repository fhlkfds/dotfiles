#!/usr/bin/env bash
# Route Hyprvoice through either the microphone paired with the default audio
# output or an explicitly selected PipeWire source.
set -euo pipefail

config=${VOICE_DICTATION_CONFIG:-"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/voice-dictation.json"}
hyprvoice_config=${HYPRVOICE_CONFIG:-"${XDG_CONFIG_HOME:-$HOME/.config}/hyprvoice/config.toml"}
hyprvoice_bin=${HYPRVOICE:-hyprvoice}
notify_send=${NOTIFY_SEND:-notify-send}
gdbus=${GDBUS:-gdbus}
hyprctl_bin=${HYPRCTL:-hyprctl}
playerctl_bin=${PLAYERCTL:-playerctl}
target_file=${VOICE_DICTATION_TARGET:-"${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/voice-dictation-target"}
paused_media_file="$target_file.media"

resolved_source=
resolved_label=
used_fallback=false

die() { printf 'voice-dictation: %s\n' "$*" >&2; exit 1; }
valid_name() { [[ $1 =~ ^[[:alnum:]_.:-]+$ ]]; }

mode() {
  [[ -r $config ]] || { printf 'default-output'; return; }
  jq -r '.mode // "default-output"' "$config" 2>/dev/null || printf 'default-output'
}

selected_source() {
  [[ -r $config ]] || return 1
  jq -r '.source // empty' "$config" 2>/dev/null
}

# On unless voice-dictation.json sets "pause_media": false.
pause_media_enabled() {
  [[ -r $config ]] || return 0
  [[ $(jq -r '.pause_media != false' "$config" 2>/dev/null) != false ]]
}

save_selection() {
  local selected_mode=$1 source=${2:-} tmp
  mkdir -p -- "$(dirname -- "$config")"
  tmp=$(mktemp "${config}.XXXXXX")
  # Keep other settings, such as pause_media.
  jq -e --arg mode "$selected_mode" --arg source "$source" \
    '(objects // {}) + {mode: $mode, source: $source}' "$config" >"$tmp" 2>/dev/null ||
    jq -n --arg mode "$selected_mode" --arg source "$source" \
      '{mode: $mode, source: $source}' >"$tmp"
  mv -f -- "$tmp" "$config"
}

sources_json() {
  pw-dump | jq -c '[.[]
    | select(.type == "PipeWire:Interface:Node")
    | .info.props as $props
    | select($props["media.class"] == "Audio/Source")
    | select(($props["node.name"] // "") != "")
    | {name: $props["node.name"], label: ($props["node.description"] // $props["node.name"]), deviceId: ($props["device.id"] // "")}
  ]'
}

resolve_default_output_source() {
  local device_id
  device_id=$(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null |
    sed -n 's/^[[:space:]]*\* device.id = "\([^"]*\)"/\1/p' | head -n1)
  [[ $device_id =~ ^[0-9]+$ ]] || return 1
  sources_json | jq -r --arg id "$device_id" \
    '.[] | select((.deviceId | tostring) == $id) | .name' | head -n1
}

resolve_default_source() {
  wpctl inspect @DEFAULT_AUDIO_SOURCE@ 2>/dev/null |
    sed -n 's/^[[:space:]]*\* node.name = "\([^"]*\)"/\1/p' | head -n1
}

source_label() {
  local source=$1 label
  label=$(sources_json | jq -r --arg source "$source" \
    '.[] | select(.name == $source) | .label' | head -n1)
  printf '%s\n' "${label:-$source}"
}

resolve_source() {
  local selected_mode source
  used_fallback=false
  selected_mode=$(mode)
  case $selected_mode in
    default-output)
      source=$(resolve_default_output_source || true)
      if [[ -z $source ]]; then
        source=$(resolve_default_source)
        valid_name "$source" || die 'could not identify the default audio input device'
        sources_json | jq -e --arg source "$source" \
          '.[] | select(.name == $source)' >/dev/null || die 'the default audio input is unavailable'
        used_fallback=true
      fi
      ;;
    source)
      source=$(selected_source || true)
      valid_name "$source" || die 'the configured microphone name is invalid'
      sources_json | jq -e --arg source "$source" \
        '.[] | select(.name == $source)' >/dev/null || die 'the configured microphone is unavailable'
      ;;
    *) die 'the configured input mode is invalid' ;;
  esac
  resolved_source=$source
  resolved_label=$(source_label "$source")
}

notify_fallback() {
  local label=$1 title='Voice dictation' body
  body="Using $label microphone"
  "$notify_send" -a 'Voice dictation' -r 9931 -t 2500 "$title" "$body" >/dev/null 2>&1 && return
  "$gdbus" call --session \
    --dest org.freedesktop.Notifications \
    --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.Notify \
    'Voice dictation' 9931 '' "$title" "$body" '[]' '{}' 2500 >/dev/null 2>&1 || true
}

sync_hyprvoice_config() {
  local source=$1
  [[ -f $hyprvoice_config ]] || die 'Hyprvoice is not configured; run hyprvoice onboarding first'
  python3 - "$hyprvoice_config" "$source" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
device = sys.argv[2]
text = path.read_text()
original = text
section = re.compile(r"(?ms)^\[recording\]\s*$\n(.*?)(?=^\[|\Z)")
match = section.search(text)
if match:
    body = match.group(1)
    lines = body.splitlines(keepends=True)
    device_lines = [index for index, line in enumerate(lines)
                    if re.match(r"^(?P<indent>\s*)device\s*=.*(?:\n|$)", line)]
    if device_lines:
        first = device_lines[0]
        indent = re.match(r"^(?P<indent>\s*)", lines[first]).group("indent")
        lines[first] = f'{indent}device = "{device}"\n'
        # Older runs could have appended another device key.  TOML forbids
        # duplicate keys, so remove every remaining one in this section.
        for index in reversed(device_lines[1:]):
            del lines[index]
        body = "".join(lines)
    else:
        line = f'device = "{device}"\n'
        body = line + body
    text = text[:match.start(1)] + body + text[match.end(1):]
else:
    line = f'device = "{device}"\n'
    if text and not text.endswith("\n"):
        text += "\n"
    text += "\n[recording]\n" + line
if text == original:
    raise SystemExit(0)
tmp = path.with_suffix(path.suffix + ".tmp")
tmp.write_text(text)
tmp.replace(path)
PY
}

hyprvoice_status() {
  "$hyprvoice_bin" status 2>/dev/null | sed -n 's/^STATUS status=//p'
}

active_window() {
  "$hyprctl_bin" -j activewindow 2>/dev/null | jq -r '.address // empty'
}

window_open() {
  "$hyprctl_bin" -j clients | jq -e --arg address "$1" 'any(.[]; .address == $address)' >/dev/null
}

option_value() {
  "$hyprctl_bin" getoption "$1" -j | jq -er '(.int | numbers) // (.bool | booleans | tostring)'
}

# Lua-provider dispatch, as in app-widget.
focus_window() {
  "$hyprctl_bin" -q dispatch "hl.dsp.focus({ window = \"address:$1\" })"
}

# Include the instance in status checks because bare selectors also match
# instances of the same application.
media_status() {
  "$playerctl_bin" -p "$1" -f '{{status}} {{playerInstance}}' status 2>/dev/null
}

# Pause playing MPRIS media without recording failed pause requests.
pause_media() {
  local players tmp player
  pause_media_enabled && command -v "$playerctl_bin" >/dev/null 2>&1 || return 0
  players=$("$playerctl_bin" -a -i playerctld -f '{{status}} {{playerInstance}}' status 2>/dev/null |
    sed -n 's/^Playing //p') || true
  [[ -n $players ]] || return 0
  tmp=$(mktemp "$paused_media_file.XXXXXX") || return 0
  mv -fT -- "$tmp" "$paused_media_file" 2>/dev/null || { rm -f -- "$tmp"; return 0; }
  while IFS= read -r player; do
    valid_name "$player" && [[ $player != playerctld ]] || continue
    # A bare selector can match another instance after the original closes.
    [[ $(media_status "$player" || true) == "Playing $player" ]] || continue
    [[ $start_interrupted == false ]] || exit 1
    if "$playerctl_bin" -p "$player" pause >/dev/null 2>&1; then
      printf '%s\n' "$player" >>"$paused_media_file" || {
        "$playerctl_bin" -p "$player" play >/dev/null 2>&1 || true
        return 0
      }
    fi
    [[ $start_interrupted == false ]] || exit 1
  done <<<"$players"
}

resume_media() {
  local player
  if [[ -L $paused_media_file ]]; then
    rm -f -- "$paused_media_file"
    return 0
  fi
  [[ -f $paused_media_file ]] || return 0
  while IFS= read -r player; do
    valid_name "$player" && [[ $player != playerctld ]] || continue
    # Respect stopped/playing media and skip a different replacement instance.
    [[ $(media_status "$player" || true) == "Paused $player" ]] || continue
    "$playerctl_bin" -p "$player" play >/dev/null 2>&1 || true
  done <"$paused_media_file"
  rm -f -- "$paused_media_file" || true
}

# A failed stop that is still listening must stay quiet and remain retryable.
stop_listening() {
  local status=0
  "$hyprvoice_bin" toggle || status=$?
  if (( status != 0 )) && [[ $(hyprvoice_status || true) == transcribing ]]; then
    return "$status"
  fi
  resume_media
  rm -f -- "$target_file"
  return "$status"
}

# Remember the window holding the text box, so the mouse is free to wander
# while speaking.
start_dictation() {
  local tmp
  # EXIT on errexit runs after Bash has unwound function-local variables.
  start_interrupted=false
  start_requested=false
  rm -f -- "$paused_media_file" 2>/dev/null || true
  tmp=$(mktemp "$target_file.XXXXXX") || exec "$hyprvoice_bin" toggle
  active_window >"$tmp" || true
  mv -fT -- "$tmp" "$target_file" || rm -f -- "$tmp"
  trap '
    if [[ $start_requested == false || $(hyprvoice_status || true) != transcribing ]]; then
      resume_media
      rm -f -- "$target_file"
    fi
  ' EXIT
  # Defer exit until a successful pause has been recorded for cleanup.
  trap 'start_interrupted=true' INT TERM HUP
  pause_media
  [[ $start_interrupted == false ]] || exit 1
  start_requested=true
  "$hyprvoice_bin" toggle
  [[ $start_interrupted == false ]] || exit 1
  trap - EXIT INT TERM HUP
}

# Hyprvoice types into whatever has keyboard focus, and follow_mouse hands
# focus to the window under the cursor. Focus the remembered window with mouse
# focus and cursor warps off until the text is typed, then hand focus back.
finish_dictation() {
  local target follow warps
  target=$(cat -- "$target_file" 2>/dev/null || true)
  if [[ ! $target =~ ^0x[[:xdigit:]]+$ ]] || ! window_open "$target" ||
    ! follow=$(option_value input:follow_mouse) || ! warps=$(option_value cursor:no_warps); then
    stop_listening
    exit
  fi
  return_to=$(active_window || true)
  restore_config="hl.config({ input = { follow_mouse = $follow }, cursor = { no_warps = $warps } })"
  trap restore_focus EXIT
  trap 'exit 1' INT TERM HUP
  "$hyprctl_bin" -q eval 'hl.config({ input = { follow_mouse = 0 }, cursor = { no_warps = true } })'
  focus_window "$target"
  stop_listening
  # ponytail: polls every 0.1s for at most two minutes; an LLM step slower than
  # that gets its focus back early.
  for _ in {1..1200}; do
    [[ $(hyprvoice_status) =~ ^(transcribing|processing|injecting)$ ]] || break
    sleep 0.1
  done
}

restore_focus() {
  if [[ $return_to =~ ^0x[[:xdigit:]]+$ ]] && window_open "$return_to"; then
    focus_window "$return_to" || true
  fi
  "$hyprctl_bin" -q eval "$restore_config" || true
}

choose() {
  local choice key
  command -v rofi >/dev/null 2>&1 || die 'rofi is required to choose a dictation microphone'
  choice=$({
    printf 'Follow default output\tdefault-output\n'
    sources_json | jq -r '.[] | "\(.label)\t\(.name)"'
  } | rofi -dmenu -i -p 'Dictation microphone') || exit 0
  key=${choice#*$'\t'}
  [[ $key != "$choice" ]] || die 'no microphone was selected'
  if [[ $key == default-output ]]; then
    save_selection default-output
  else
    valid_name "$key" || die 'selected microphone name is invalid'
    save_selection source "$key"
  fi
}

toggle() {
  local dry_run=$1
  if [[ $dry_run == true ]]; then
    resolve_source
    printf 'action=would-toggle device=%s\n' "$resolved_source"
    [[ $used_fallback == false ]] || printf 'notification=Using %s microphone\n' "$resolved_label"
    return
  fi
  command -v "$hyprvoice_bin" >/dev/null 2>&1 ||
    die 'Hyprvoice is not installed; install hyprvoice-bin and run hyprvoice onboarding'
  umask 077
  mkdir -p -- "$(dirname -- "$target_file")"
  # Drop repeated shortcut presses while a focus transaction is still running.
  exec 9>"$target_file.lock"
  flock -n 9 || return 0
  # While listening Hyprvoice reports "transcribing"; a toggle then types it.
  case $(hyprvoice_status) in
    idle)
      # Stopping must still work if the selected microphone was unplugged.
      resolve_source
      sync_hyprvoice_config "$resolved_source"
      [[ $used_fallback == false ]] || notify_fallback "$resolved_label"
      start_dictation
      ;;
    transcribing) finish_dictation ;;
    processing|injecting) return 0 ;;
    *) exec "$hyprvoice_bin" toggle ;;
  esac
}

usage() {
  printf 'usage: %s {toggle [--dry-run]|resolve-source|use-default-output|use-source NAME|choose|status}\n' "${0##*/}" >&2
  exit 2
}

case ${1:-} in
  toggle)
    [[ -z ${3:-} && ( -z ${2:-} || ${2:-} == --dry-run ) ]] || usage
    if [[ ${2:-} == --dry-run ]]; then
      toggle true
    else
      toggle false
    fi
    ;;
  resolve-source) [[ $# -eq 1 ]] || usage; resolve_source; printf '%s\n' "$resolved_source" ;;
  use-default-output) [[ $# -eq 1 ]] || usage; save_selection default-output ;;
  use-source) [[ $# -eq 2 ]] || usage; valid_name "$2" || die 'invalid microphone name'; save_selection source "$2" ;;
  choose) [[ $# -eq 1 ]] || usage; choose ;;
  status) printf 'mode=%s\n' "$(mode)"; resolve_source; printf 'device=%s\n' "$resolved_source" ;;
  *) usage ;;
esac
