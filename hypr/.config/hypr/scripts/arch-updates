#!/usr/bin/env bash

set -u

# Every caller of this script -- the Quickshell widget, lmenu, a shell prompt --
# ends up querying the AUR, and none of them can see how recently another one
# did. The cache is the only place that knows, so the request floor lives here
# rather than in any single caller. ARCH_UPDATES_TTL=0 disables it for tests.
cache_dir=${ARCH_UPDATES_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/arch-updates}
cache_ttl=${ARCH_UPDATES_TTL:-600}
cache_payload=$cache_dir/count.json
cache_stamp=$cache_dir/last-attempt
cache_status=$cache_dir/last-status

count_lines() {
  local line count=0

  while IFS= read -r line; do
    [[ -n $line ]] && ((count += 1))
  done <<< "$1"
  printf '%d' "$count"
}

package_names_json() {
  local output=$1 line package escaped first=1

  printf '['
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -n $line ]] || continue
    package=${line%%[[:space:]]*}
    escaped=${package//\\\\/\\\\\\\\}
    escaped=${escaped//\"/\\\"}
    escaped=${escaped//$'\n'/\\n}
    escaped=${escaped//$'\r'/\\r}
    escaped=${escaped//$'\t'/\\t}
    (( first )) || printf ','
    printf '"%s"' "$escaped"
    first=0
  done <<< "$output"
  printf ']'
}

# checkupdates exits 2 when the sync succeeded and nothing is outdated, and
# 1 when it could not sync at all. Collapsing both to 0 made the bar claim the
# system was up to date whenever the network was down, so a failed sync is
# reported as an error instead and the caller keeps its last known count.
repo_updates() {
  local output status

  output=$(checkupdates 2>/dev/null)
  status=$?
  case $status in
    0) printf '%s' "$output" ;;
    2) return 0 ;;
    *) return 1 ;;
  esac
}

# yay can exit 1 with no updates. Diagnostics are not package names, and a
# failed request must not turn into either a fake package or a clean zero.
# yay 13 can append the update's age ("pkg 1-1 -> 2-1 [15h44m]"); rejecting
# that failed the whole check and hid the repo count along with the AUR one.
# Accept complete trailing bracketed annotations, never brackets in versions.
aur_update_line='^[^][[:space:]]+[[:space:]]+[^][[:space:]]+[[:space:]]+->[[:space:]]+[^][[:space:]]+([[:space:]]+\[[^][]*\])*$'
aur_updates() {
  local helper output status error_file error line

  helper=$1
  error_file=$(mktemp) || return 1
  output=$("$helper" -Qua 2>"$error_file")
  status=$?
  error=$(<"$error_file")
  rm -f "$error_file"
  if ((status != 0)) && { ((status != 1)) || [[ -n $error ]]; }; then
    printf '%s\n' "$error" >&2
    return 1
  fi
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    [[ $line =~ $aur_update_line ]] || {
      printf 'unexpected %s output: %s\n' "${helper##*/}" "$line" >&2
      return 1
    }
  done <<< "$output"
  printf '%s' "$output"
}

aur_helper() {
  command -v yay
}

apt_updates() {
  local output
  output=$(LC_ALL=C apt list --upgradable 2>/dev/null) || return 1
  awk -F/ '/^[^[:space:]]+\// { print $1 }' <<< "$output"
}

now_epoch() {
  printf '%(%s)T' -1
}

# Records that an attempt happened even when it fails, so a run that is being
# throttled or is hanging cannot be retried in a tight loop.
mark_attempt() {
  local status=$1

  ((cache_ttl > 0)) || return 0
  mkdir -p "$cache_dir" 2>/dev/null || return 0
  now_epoch > "$cache_stamp" 2>/dev/null || true
  printf '%d' "$status" > "$cache_status" 2>/dev/null || true
}

store_payload() {
  local payload=$1 tmp

  ((cache_ttl > 0)) || return 0
  mkdir -p "$cache_dir" 2>/dev/null || return 0
  tmp=$cache_dir/.count.$$
  printf '%s\n' "$payload" > "$tmp" 2>/dev/null && mv -f "$tmp" "$cache_payload" 2>/dev/null || rm -f "$tmp" 2>/dev/null
}

# Returns 0 and prints the cached JSON when the last attempt is still inside the
# TTL and succeeded, 2 when it is inside the TTL but failed (so the caller keeps
# showing its last known count), and 1 when the cache is cold or expired.
serve_cached() {
  local last status

  ((cache_ttl > 0)) || return 1
  [[ -r $cache_stamp ]] || return 1
  last=$(<"$cache_stamp") 2>/dev/null || return 1
  [[ $last =~ ^[0-9]+$ ]] || return 1
  (( $(now_epoch) - last < cache_ttl )) || return 1

  status=0
  [[ -r $cache_status ]] && status=$(<"$cache_status")
  [[ $status == 0 && -s $cache_payload ]] || return 2
  printf '%s\n' "$(<"$cache_payload")"
}

compute_count() {
  local helper repo_output aur_output='' repo aur

  if command -v pacman >/dev/null 2>&1 || command -v checkupdates >/dev/null 2>&1; then
    # Without pacman-contrib there is no checkupdates. Counting that as zero
    # repo updates hid every pending pacman package behind the AUR count.
    if ! command -v checkupdates >/dev/null 2>&1; then
      printf '{"error":"checkupdates missing (install pacman-contrib)"}\n' >&2
      return 1
    fi
    repo_output=$(repo_updates) || { printf '{"error":"sync failed"}\n' >&2; return 1; }
    if helper=$(aur_helper); then
      aur_output=$(aur_updates "$helper") || { printf '{"error":"AUR check failed"}\n' >&2; return 1; }
    fi
  elif command -v apt >/dev/null 2>&1; then
    repo_output=$(apt_updates) || { printf '{"error":"apt check failed"}\n' >&2; return 1; }
  else
    repo_output=''
  fi
  repo=$(count_lines "$repo_output")
  aur=$(count_lines "$aur_output")
  printf '{"repo":%d,"aur":%d,"total":%d,"repoPackages":%s,"aurPackages":%s}\n' \
    "$repo" "$aur" "$((repo + aur))" \
    "$(package_names_json "$repo_output")" "$(package_names_json "$aur_output")"
}

print_count() {
  local cached payload status

  cached=$(serve_cached)
  case $? in
    0) printf '%s\n' "$cached"; return 0 ;;
    2) printf '{"error":"throttled after a failed check"}\n' >&2; return 1 ;;
  esac

  mark_attempt 1
  payload=$(compute_count)
  status=$?
  if ((status != 0)); then
    return "$status"
  fi
  mark_attempt 0
  store_payload "$payload"
  printf '%s\n' "$payload"
}

notify() {
  command -v notify-send >/dev/null 2>&1 && notify-send "System Update" "$1"
  printf '%s\n' "$1" >&2
}

terminal() {
  local candidate

  for candidate in "${TERMINAL:-}" kitty foot alacritty ghostty; do
    [[ -n $candidate ]] || continue
    command -v "$candidate" >/dev/null 2>&1 && { command -v "$candidate"; return 0; }
  done
  return 1
}

# The upgrade needs an interactive terminal so sudo and the AUR helper can
# prompt, and the window is held open on a read so the log stays readable.
# The child records the manager's status separately: Kitty's exit status does
# not reliably reflect its child's. Only a completed successful upgrade prints
# its scope (all, repo or aur) so the widget clears the appropriate count.
#
# Unattended: --noconfirm takes every prompt's default, which is yes to the
# upgrade, replacements and PGP key imports and no to removing conflicting or
# dependency-broken packages, so a removal aborts instead of happening. Build
# files are not reviewed and makedepends are kept. No --devel: it would
# git ls-remote every -git package on each run.
run_update() (
  local term manager helper='' update_status flags=() result_file scope manager_status term_args

  if helper=$(aur_helper); then
    manager=aur
    flags=(--noconfirm --noremovemake --sudoloop
           --answerclean None --answerdiff None --answeredit None)
  elif command -v pacman >/dev/null 2>&1; then
    manager=pacman
  elif command -v apt >/dev/null 2>&1; then
    manager=apt
  else
    notify "No package manager found (yay, pacman, or apt)."
    return 1
  fi
  if ! term=$(terminal); then
    notify "No terminal emulator found."
    return 1
  fi

  # The terminal's stdout and exit status are not the manager's. A result is
  # written only after the manager finishes; an empty file means cancellation
  # or a terminal that never ran its child.
  result_file=$(mktemp) || return 1
  trap 'rm -f "$result_file"' EXIT
  term_args=(--title "System Update")
  case ${term##*/} in
    alacritty) term_args+=(-e) ;;
    ghostty) term_args=(--gtk-single-instance=false --title="System Update" -e) ;;
  esac
  # The title is what the Hyprland window rule matches to open this silently
  # on workspace 1.
  "$term" "${term_args[@]}" bash -c '
    manager=$1 helper=$2 result_file=$3
    shift 3
    scope=repo
    if [[ $manager == aur ]]; then
      read -rp "Update [B]oth, [p]acman only, or [a]UR only? " choice || exit 1
      case ${choice,,} in
        p|pacman) scope=repo; set -- -Syu --repo "$@" ;;
        a|aur) scope=aur; set -- -Sua "$@" ;;
        ""|b|both) scope=all; set -- -Syu "$@" ;;
        *) printf "Invalid update choice.\n" >&2; exit 1 ;;
      esac
    fi
    case $manager in
      aur) "$helper" "$@" ;;
      pacman) sudo pacman -Syu --noconfirm ;;
      apt) sudo apt update && sudo apt full-upgrade ;;
    esac
    status=$?
    printf "%s %d\n" "$scope" "$status" > "$result_file" || exit 1
    printf "\n"
    read -rp "Done. Press Enter to close. " _
    exit $status
  ' _ "$manager" "$helper" "$result_file" "${flags[@]}" >&2
  update_status=$?
  scope=''
  manager_status=''
  read -r scope manager_status < "$result_file" || true
  if [[ $scope =~ ^(all|repo|aur)$ && $manager_status =~ ^[0-9]+$ ]] && ((manager_status <= 255)); then
    update_status=$manager_status
  elif ((update_status == 0)); then
    update_status=1
  fi
  # The upgrade queried the repositories. Keep the attempt recent so a
  # subsequent count cannot immediately repeat the request.
  if ((cache_ttl > 0)); then
    rm -f "$cache_payload" 2>/dev/null || true
    mark_attempt 1
  fi
  ((update_status == 0)) && printf '%s\n' "$scope"
  return "$update_status"
)

case ${1:-count} in
  update) run_update ;;
  *) print_count ;;
esac
