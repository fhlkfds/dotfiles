#!/usr/bin/env python3
"""Launch the XDG default browser using its private-window desktop action."""

from __future__ import annotations

import configparser
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path


PRIVATE_ACTIONS = (
    "new-private-window",
    "new-private",
    "private-window",
    "incognito",
)

PRIVATE_FLAGS = {
    "brave": "--incognito",
    "brave-browser": "--incognito",
    "chromium": "--incognito",
    "chromium-browser": "--incognito",
    "google-chrome": "--incognito",
    "google-chrome-stable": "--incognito",
    "helium": "--incognito",
    "helium-browser": "--incognito",
    "microsoft-edge": "--incognito",
    "microsoft-edge-stable": "--incognito",
    "vivaldi": "--incognito",
    "vivaldi-stable": "--incognito",
    "firefox": "--private-window",
    "floorp": "--private-window",
    "librewolf": "--private-window",
    "waterfox": "--private-window",
}


def fail(message: str) -> "NoReturn":
    print(f"default-browser-private: {message}", file=sys.stderr)
    if shutil.which("notify-send") and not os.environ.get(
        "DEFAULT_BROWSER_PRIVATE_NO_NOTIFY"
    ):
        subprocess.run(
            ["notify-send", "Private browser", message],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    raise SystemExit(1)


def default_desktop_id() -> str:
    override = os.environ.get("DEFAULT_BROWSER_PRIVATE_DESKTOP", "").strip()
    if override:
        return override

    for command in (
        ["xdg-settings", "get", "default-web-browser"],
        ["xdg-mime", "query", "default", "x-scheme-handler/https"],
        ["xdg-mime", "query", "default", "text/html"],
    ):
        try:
            result = subprocess.run(
                command, capture_output=True, text=True, check=False, timeout=5
            )
        except (OSError, subprocess.TimeoutExpired):
            continue
        desktop_id = result.stdout.strip()
        if result.returncode == 0 and desktop_id:
            return desktop_id

    fail("no XDG default web browser is configured")


def application_dirs() -> list[Path]:
    override = os.environ.get("DEFAULT_BROWSER_PRIVATE_DATA_DIRS")
    if override is not None:
        return [Path(item) / "applications" for item in override.split(":") if item]

    data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    data_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share")
    return [data_home / "applications"] + [
        Path(item) / "applications" for item in data_dirs.split(":") if item
    ]


def find_desktop_file(desktop_id: str) -> Path:
    direct = Path(desktop_id).expanduser()
    if direct.is_absolute() and direct.is_file():
        return direct

    for directory in application_dirs():
        candidate = directory / desktop_id
        if candidate.is_file():
            return candidate

    # Desktop IDs encode an applications subdirectory with dashes. This slower
    # path is only needed for entries which are not stored at the directory root.
    for directory in application_dirs():
        if not directory.is_dir():
            continue
        for candidate in directory.rglob("*.desktop"):
            relative_id = str(candidate.relative_to(directory)).replace(os.sep, "-")
            if relative_id == desktop_id:
                return candidate

    fail(f"cannot find desktop entry {desktop_id!r}")


def parse_exec(value: str) -> list[str]:
    try:
        words = shlex.split(value, posix=True)
    except ValueError as exc:
        fail(f"invalid Exec line in desktop entry: {exc}")

    command: list[str] = []
    for word in words:
        # A browser launch without a URL has no value for desktop field codes.
        if word in {"%f", "%F", "%u", "%U", "%i", "%c", "%k"}:
            continue
        command.append(word.replace("%%", "%"))
    if not command:
        fail("the browser desktop entry has an empty Exec command")
    return command


def private_command(desktop_file: Path) -> list[str]:
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    parser.optionxform = str
    try:
        with desktop_file.open(encoding="utf-8") as handle:
            parser.read_file(handle)
    except (OSError, UnicodeError, configparser.Error) as exc:
        fail(f"cannot read {desktop_file}: {exc}")

    sections = {section.lower(): section for section in parser.sections()}
    for action in PRIVATE_ACTIONS:
        section = sections.get(f"desktop action {action}".lower())
        if section and parser.has_option(section, "Exec"):
            return parse_exec(parser.get(section, "Exec"))

    if not parser.has_option("Desktop Entry", "Exec"):
        fail(f"{desktop_file.name} has no private action or main Exec command")

    command = parse_exec(parser.get("Desktop Entry", "Exec"))
    executable = Path(command[0]).name.lower()
    flag = PRIVATE_FLAGS.get(executable)
    if flag is None:
        fail(
            f"{desktop_file.name} does not declare a private-window action, "
            f"and private mode is unknown for {executable!r}"
        )
    return [*command, flag]


def main() -> int:
    if len(sys.argv) != 1:
        print("usage: default-browser-private", file=sys.stderr)
        return 2

    desktop_id = default_desktop_id()
    desktop_file = find_desktop_file(desktop_id)
    command = private_command(desktop_file)
    if shutil.which(command[0]) is None and not Path(command[0]).is_file():
        fail(f"browser executable not found: {command[0]}")

    if os.environ.get("DEFAULT_BROWSER_PRIVATE_DRY_RUN"):
        print(shlex.join(command))
        return 0

    os.execvp(command[0], command)


if __name__ == "__main__":
    raise SystemExit(main())
