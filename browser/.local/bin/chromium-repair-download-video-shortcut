#!/usr/bin/env python3
"""Remove obsolete Download Video command registrations from Chromium state."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import socket
import stat
import sys
import tempfile
from datetime import datetime, timezone


STALE_EXTENSION_IDS = {
    "ghonieaepjklijjefmnbicmikhonnoej",
    "kgbmkkhmlonlobngnjpncdlgaipnabmc",
}
CURRENT_EXTENSION_ID = "dedjgknigfeelejglamclffonmophnfl"


def browser_is_running(profile_root: Path) -> bool:
    socket_link = profile_root / "SingletonSocket"
    try:
        if not stat.S_ISSOCK(socket_link.stat().st_mode):
            return False
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(0.25)
            client.connect(str(socket_link))
        return True
    except (ConnectionRefusedError, FileNotFoundError):
        return False
    except OSError:
        return True


def repair(data: dict) -> tuple[list[str], list[str]]:
    extensions = data.get("extensions")
    if not isinstance(extensions, dict):
        return [], []

    removed_commands: list[str] = []
    commands = extensions.get("commands")
    if isinstance(commands, dict):
        for shortcut, registration in list(commands.items()):
            if not isinstance(registration, dict):
                continue
            if (
                registration.get("command_name") == "download-video"
                and registration.get("extension") in STALE_EXTENSION_IDS
            ):
                del commands[shortcut]
                removed_commands.append(shortcut)

    removed_settings: list[str] = []
    settings = extensions.get("settings")
    if isinstance(settings, dict):
        for extension_id in sorted(STALE_EXTENSION_IDS):
            if extension_id in settings:
                del settings[extension_id]
                removed_settings.append(extension_id)

    return removed_commands, removed_settings


def atomic_write(path: Path, data: dict) -> None:
    original_mode = stat.S_IMODE(path.stat().st_mode)
    fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            json.dump(data, output, ensure_ascii=False, separators=(",", ":"))
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, original_mode)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Remove stale Alt+Shift+D registrations so the pinned Omarchy "
            "Download Video extension can claim the shortcut on next launch."
        )
    )
    parser.add_argument("profile_root", type=Path)
    parser.add_argument("--profile-directory", default="Default")
    parser.add_argument(
        "--apply", action="store_true", help="write the repair; otherwise only preview it"
    )
    args = parser.parse_args()

    profile_root = args.profile_root.expanduser().resolve()
    preferences = profile_root / args.profile_directory / "Preferences"
    if not preferences.is_file():
        parser.error(f"Preferences not found: {preferences}")

    with preferences.open(encoding="utf-8") as source:
        data = json.load(source)
    removed_commands, removed_settings = repair(data)

    if not removed_commands and not removed_settings:
        print("No stale Download Video registration found.")
        return 0

    print(f"Preferences: {preferences}")
    for shortcut in removed_commands:
        print(f"Remove stale shortcut: {shortcut}")
    for extension_id in removed_settings:
        print(f"Remove stale extension state: {extension_id}")
    print(f"Current extension ID: {CURRENT_EXTENSION_ID}")

    if not args.apply:
        print("Dry run only; pass --apply after completely closing the browser.")
        return 0
    if browser_is_running(profile_root):
        print(
            f"Refusing to edit {preferences}: browser is still running.",
            file=sys.stderr,
        )
        return 2

    timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup = preferences.with_name(f"Preferences.before-video-repair.{timestamp}")
    shutil.copy2(preferences, backup)
    atomic_write(preferences, data)
    print(f"Backup: {backup}")
    print("Repair applied. Start the browser, then use Alt+Shift+D on a video page.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
