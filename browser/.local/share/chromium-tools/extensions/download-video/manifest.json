{
  "manifest_version": 3,
  "name": "Download Video",
  "version": "1.0.0",
  "description": "Download video from the active page with yt-dlp.",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "action": { "default_title": "Download Video" },
  "commands": {
    "download-video": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Download Video"
    }
  },
  "background": { "service_worker": "background.js" }
}
