/** Compact calculator layout over the generated active desktop palette. */
@theme "~/.config/rofi/current-theme.rasi"

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 540px;
    padding: 24px;
    border: @border-width;
    border-radius: @radius-window;
    border-color: @window-border;
    background-color: @bg0;
}

mainbox {
    spacing: 16px;
    background-color: transparent;
    children: [ "inputbar", "message", "listview" ];
}

inputbar {
    spacing: 12px;
    padding: 16px 18px;
    border: 1px solid;
    border-radius: @radius-input;
    border-color: @selected-border;
    background-color: @bg1;
    children: [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    expand: false;
    text-color: @accent;
    background-color: transparent;
}

entry {
    placeholder: "Type an expression…";
    placeholder-color: @fg2;
    text-color: @fg0;
    cursor: text;
    background-color: transparent;
}

message {
    padding: 0px 6px;
    background-color: transparent;
}

textbox {
    background-color: transparent;
    text-color: @fg2;
    vertical-align: 0.5;
}

listview {
    columns: 1;
    lines: 1;
    fixed-height: false;
    cycle: true;
    scrollbar: false;
    background-color: transparent;
}

element {
    padding: 18px;
    border: 1px solid;
    border-radius: @radius-row;
    border-color: @selected-border;
    background-color: @selected-bg;
    text-color: @fg0;
}

element selected.normal {
    border-color: @accent;
    background-color: @selected-bg;
    text-color: @fg0;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
