/**
 * nord-dark.rasi
 * Nord (Polar Night) palette on the comet-glass layout
 */

@theme "~/.config/rofi/comet-glass.rasi"

* {
    bg0: rgba(46, 52, 64, 93%);
    bg1: rgba(59, 66, 82, 95%);
    bg2: #434C5E;

    fg0: #ECEFF4;
    fg1: #D8DEE9;
    fg2: #7B88A1;

    accent: #88C0D0;
    accent-alt: #81A1C1;
    border-col: #5E81AC;
    urgent: #BF616A;
    good: #A3BE8C;

    window-border: rgba(136, 192, 208, 40%);
    alt-bg: rgba(255, 255, 255, 3%);
    urgent-bg: rgba(191, 97, 106, 10%);
    urgent-border: rgba(191, 97, 106, 18%);
    active-bg: rgba(163, 190, 140, 8%);
    active-border: rgba(163, 190, 140, 16%);
    selected-bg: rgba(136, 192, 208, 14%);
    selected-border: rgba(136, 192, 208, 34%);
    selected-active-bg: rgba(163, 190, 140, 14%);
    selected-active-border: rgba(163, 190, 140, 32%);
    selected-urgent-bg: rgba(191, 97, 106, 15%);
    selected-urgent-border: rgba(191, 97, 106, 34%);
    button-selected-bg: rgba(129, 161, 193, 16%);
}
