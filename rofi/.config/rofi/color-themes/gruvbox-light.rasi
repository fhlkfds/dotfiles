/**
 * gruvbox-light.rasi
 * Gruvbox Light palette on the comet-glass layout
 */

@theme "~/.config/rofi/comet-glass.rasi"

* {
    bg0: rgba(251, 241, 199, 95%);
    bg1: rgba(235, 219, 178, 97%);
    bg2: #D5C4A1;

    fg0: #3C3836;
    fg1: #504945;
    fg2: #7C6F64;

    accent: #AF3A03;
    accent-alt: #076678;
    border-col: #928374;
    urgent: #9D0006;
    good: #79740E;

    window-border: rgba(175, 58, 3, 45%);
    alt-bg: rgba(0, 0, 0, 4%);
    urgent-bg: rgba(157, 0, 6, 10%);
    urgent-border: rgba(157, 0, 6, 22%);
    active-bg: rgba(121, 116, 14, 10%);
    active-border: rgba(121, 116, 14, 22%);
    selected-bg: rgba(175, 58, 3, 14%);
    selected-border: rgba(175, 58, 3, 34%);
    selected-active-bg: rgba(121, 116, 14, 14%);
    selected-active-border: rgba(121, 116, 14, 32%);
    selected-urgent-bg: rgba(157, 0, 6, 15%);
    selected-urgent-border: rgba(157, 0, 6, 32%);
    button-selected-bg: rgba(7, 102, 120, 14%);
}
