/**
 * tokyo-night.rasi
 * Tokyo Night palette on the comet-glass layout
 */

@theme "~/.config/rofi/comet-glass.rasi"

* {
    bg0: rgba(26, 27, 38, 92%);
    bg1: rgba(22, 22, 30, 95%);
    bg2: #292E42;

    fg0: #C0CAF5;
    fg1: #A9B1D6;
    fg2: #565F89;

    accent: #7AA2F7;
    accent-alt: #BB9AF7;
    border-col: #3B4261;
    urgent: #F7768E;
    good: #9ECE6A;

    window-border: rgba(122, 162, 247, 45%);
    alt-bg: rgba(255, 255, 255, 3%);
    urgent-bg: rgba(247, 118, 142, 10%);
    urgent-border: rgba(247, 118, 142, 18%);
    active-bg: rgba(158, 206, 106, 8%);
    active-border: rgba(158, 206, 106, 16%);
    selected-bg: rgba(122, 162, 247, 14%);
    selected-border: rgba(122, 162, 247, 34%);
    selected-active-bg: rgba(158, 206, 106, 14%);
    selected-active-border: rgba(158, 206, 106, 32%);
    selected-urgent-bg: rgba(247, 118, 142, 15%);
    selected-urgent-border: rgba(247, 118, 142, 34%);
    button-selected-bg: rgba(187, 154, 247, 16%);
}
