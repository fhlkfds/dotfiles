/**
 * dracula.rasi
 * Dracula palette on the comet-glass layout
 */

@theme "~/.config/rofi/comet-glass.rasi"

* {
    bg0: rgba(40, 42, 54, 92%);
    bg1: rgba(33, 34, 44, 95%);
    bg2: #44475A;

    fg0: #F8F8F2;
    fg1: #E6E6E0;
    fg2: #6272A4;

    accent: #BD93F9;
    accent-alt: #FF79C6;
    border-col: #6272A4;
    urgent: #FF5555;
    good: #50FA7B;

    window-border: rgba(189, 147, 249, 45%);
    alt-bg: rgba(255, 255, 255, 3%);
    urgent-bg: rgba(255, 85, 85, 10%);
    urgent-border: rgba(255, 85, 85, 18%);
    active-bg: rgba(80, 250, 123, 8%);
    active-border: rgba(80, 250, 123, 16%);
    selected-bg: rgba(189, 147, 249, 14%);
    selected-border: rgba(189, 147, 249, 34%);
    selected-active-bg: rgba(80, 250, 123, 14%);
    selected-active-border: rgba(80, 250, 123, 32%);
    selected-urgent-bg: rgba(255, 85, 85, 15%);
    selected-urgent-border: rgba(255, 85, 85, 34%);
    button-selected-bg: rgba(255, 121, 198, 16%);
}
