/**
 * catppuccin-mocha.rasi
 * Catppuccin Mocha palette on the comet-glass layout
 */

@theme "~/.config/rofi/comet-glass.rasi"

* {
    bg0: rgba(30, 30, 46, 92%);
    bg1: rgba(24, 24, 37, 95%);
    bg2: #313244;

    fg0: #CDD6F4;
    fg1: #BAC2DE;
    fg2: #A6ADC8;

    accent: #89B4FA;
    accent-alt: #CBA6F7;
    border-col: #585B70;
    urgent: #F38BA8;
    good: #A6E3A1;

    window-border: rgba(137, 180, 250, 45%);
    alt-bg: rgba(255, 255, 255, 3%);
    urgent-bg: rgba(243, 139, 168, 10%);
    urgent-border: rgba(243, 139, 168, 18%);
    active-bg: rgba(166, 227, 161, 8%);
    active-border: rgba(166, 227, 161, 16%);
    selected-bg: rgba(137, 180, 250, 14%);
    selected-border: rgba(137, 180, 250, 34%);
    selected-active-bg: rgba(166, 227, 161, 14%);
    selected-active-border: rgba(166, 227, 161, 32%);
    selected-urgent-bg: rgba(243, 139, 168, 15%);
    selected-urgent-border: rgba(243, 139, 168, 34%);
    button-selected-bg: rgba(203, 166, 247, 16%);
}
