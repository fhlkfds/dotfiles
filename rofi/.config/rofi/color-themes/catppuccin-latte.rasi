/**
 * catppuccin-latte.rasi
 * Catppuccin Latte (light) palette on the comet-glass layout
 */

@theme "~/.config/rofi/comet-glass.rasi"

* {
    bg0: rgba(239, 241, 245, 94%);
    bg1: rgba(230, 233, 239, 97%);
    bg2: #CCD0DA;

    fg0: #4C4F69;
    fg1: #5C5F77;
    fg2: #8C8FA1;

    accent: #1E66F5;
    accent-alt: #8839EF;
    border-col: #9CA0B0;
    urgent: #D20F39;
    good: #40A02B;

    window-border: rgba(30, 102, 245, 40%);
    alt-bg: rgba(0, 0, 0, 4%);
    urgent-bg: rgba(210, 15, 57, 10%);
    urgent-border: rgba(210, 15, 57, 22%);
    active-bg: rgba(64, 160, 43, 10%);
    active-border: rgba(64, 160, 43, 22%);
    selected-bg: rgba(30, 102, 245, 12%);
    selected-border: rgba(30, 102, 245, 32%);
    selected-active-bg: rgba(64, 160, 43, 14%);
    selected-active-border: rgba(64, 160, 43, 32%);
    selected-urgent-bg: rgba(210, 15, 57, 14%);
    selected-urgent-border: rgba(210, 15, 57, 32%);
    button-selected-bg: rgba(136, 57, 239, 14%);
}
